# Salinan env buat deploy. Isi dulu, lalu rename jadi `.env`.
#
#   cp .env.example .env
#
# `.env` sengaja di-gitignore supaya domain & konfigurasi server nggak ikut ke repo.

# Domain yang menunjuk ke IP publik VPS (A record).
API_DOMAIN=api.domain-kamu.com

# Nama service backend di docker-compose.yml.
API_HOST=api
