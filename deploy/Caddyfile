# Reverse proxy + HTTPS otomatis (Let's Encrypt) buat backend NeVie.
#
# Caddy butuh nama domain — tanpa domain dia cuma bisa bikin sertifikat
# self-signed yang nggak dipercaya HP. Lihat docs/DEPLOYMENT.md.

{$API_DOMAIN} {
	encode zstd gzip

	reverse_proxy {$API_HOST}:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}
